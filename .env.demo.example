# Copy this file to .env in the SAI repository. Fill secrets only in .env.
# Callback URLs below are fixed for this local-only demo.
DEMO_BASE_URL=http://localhost:8788

# Google Cloud OAuth client: Web application, YouTube Data API v3 enabled.
# Redirect: http://localhost:8788/api/demo/oauth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# LinkedIn app: Sign In with LinkedIn using OpenID Connect product enabled.
# Redirect: http://localhost:8788/api/demo/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional import safety caps. Pagination continues until completion or a cap.
# DEMO_MAX_VIDEOS caps playlist entries before unique video metadata is fetched.
DEMO_MAX_PLAYLISTS=100
DEMO_MAX_VIDEOS=2000
DEMO_MAX_SUBSCRIPTIONS=500

# Optional: override the project Python executable or model-cache directory.
# SAI_PYTHON=C:/path/to/python.exe
# SAI_MODEL_CACHE=C:/path/to/model-cache

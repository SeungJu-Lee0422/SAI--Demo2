{
  "name": "sai-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "server": "node --env-file-if-exists=.env backend/local.mjs",
    "build": "node backend/build.mjs",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "node backend/run-smokes.mjs",
    "test:live": "node backend/live-smoke.mjs",
    "solver:setup": "node backend/setup-solver.mjs",
    "solver:serve": "node --env-file-if-exists=.env backend/solver-service.mjs",
    "db:migrate:turso": "node --env-file-if-exists=.env.local backend/migrate-turso.mjs",
    "test:deployment": "node --env-file-if-exists=.env.local backend/deployment-smoke.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@huggingface/transformers": "^4.3.0",
    "drizzle-orm": "0.45.2",
    "expo": "~57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.25.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}

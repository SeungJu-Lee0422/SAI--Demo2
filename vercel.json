{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "regions": ["iad1"],
  "functions": {
    "api/app.ts": {
      "maxDuration": 180,
      "includeFiles": "{shared/**/*.ts,node_modules/onnxruntime-node/bin/napi-v6/linux/x64/{onnxruntime_binding.node,libonnxruntime.so.1,libonnxruntime_providers_shared.so}}",
      "excludeFiles": "{.data/**,node_modules/onnxruntime-node/bin/napi-v6/{darwin,win32,linux/arm64}/**,node_modules/onnxruntime-node/bin/napi-v6/linux/x64/*{cuda,tensorrt}*,node_modules/onnxruntime-web/dist/*.{wasm,map}}"
    },
    "api/bridge-validate.ts": {
      "maxDuration": 180,
      "includeFiles": "{shared/**/*.ts,node_modules/onnxruntime-node/bin/napi-v6/linux/x64/{onnxruntime_binding.node,libonnxruntime.so.1,libonnxruntime_providers_shared.so}}",
      "excludeFiles": "{.data/**,node_modules/onnxruntime-node/bin/napi-v6/{darwin,win32,linux/arm64}/**,node_modules/onnxruntime-node/bin/napi-v6/linux/x64/*{cuda,tensorrt}*,node_modules/onnxruntime-web/dist/*.{wasm,map}}"
    },
    "api/solver.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,dist/**,mobile/**,browser/**,shared/**,assets/**,drizzle/**,db/**,.data/**,.omx/**,.expo/**,.git/**}"
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/:path*"},
    {"source": "/:path*", "destination": "/index.html"}
  ]
}
